(
    schema: 1,
    modes: [
        (
            id: "read",
            label: "Read",
            tabs: [
                "file",
                "view",
            ],
        ),
        (
            id: "review",
            label: "Review",
            tabs: [
                "file",
                "view",
                "pages",
                "markup",
                "measure",
            ],
        ),
        (
            id: "edit",
            label: "Edit",
            tabs: [
                "file",
                "view",
                "pages",
                "edit",
                "markup",
                "measure",
                "tools",
            ],
        ),
    ],
    tabs: [
        (
            id: "file",
            label: "File",
            question: "What do I do with the file as a whole, or with pdfce itself?",
            groups: [
                (
                    id: "file",
                    caption: "File",
                    items: [
                        Command("file.new"),
                        Command("file.new_from_template"),
                        Command("file.open"),
                        Custom(
                            kind: "recent_files",
                        ),
                        Command("file.close"),
                    ],
                ),
                (
                    id: "recognise",
                    caption: "Recognise",
                    items: [
                        Command("file.ocr"),
                    ],
                ),
                (
                    id: "save",
                    caption: "Save",
                    items: [
                        Command("file.save"),
                        Command("file.save_copy"),
                    ],
                ),
                (
                    id: "export",
                    caption: "Export",
                    items: [
                        Command("file.export_dxf"),
                        Command("file.export_form_data"),
                        Command("file.copy_page_text"),
                        Command("file.copy_document_text"),
                    ],
                ),
                (
                    id: "print",
                    caption: "Print",
                    items: [
                        Command("file.print"),
                    ],
                ),
                (
                    id: "document",
                    caption: "Document",
                    items: [
                        Command("file.properties"),
                        Command("file.fonts"),
                    ],
                ),
                (
                    id: "pdfce",
                    caption: "pdfce",
                    items: [
                        Command("file.settings"),
                        Command("file.shortcuts"),
                        Command("file.about"),
                    ],
                ),
            ],
        ),
        (
            id: "view",
            label: "View",
            question: "What is on my screen, and how is the page laid out?",
            groups: [
                (
                    id: "page_display",
                    caption: "Page display",
                    items: [
                        Command("view.page_single"),
                        Command("view.page_continuous"),
                        Command("view.page_facing"),
                        Command("view.page_facing_continuous"),
                    ],
                ),
                (
                    id: "navigate",
                    caption: "Navigate",
                    items: [
                        Command("view.tool_select"),
                        Command("view.tool_node"),
                        Command("view.tool_text"),
                        Command("view.tool_hand"),
                    ],
                ),
                (
                    id: "zoom",
                    caption: "Zoom",
                    items: [
                        Command("view.zoom_actual"),
                        Command("view.zoom_fit_page"),
                        Command("view.zoom_fit_width"),
                        Command("view.zoom_fit_height"),
                        Command("view.zoom_selection"),
                        Command("view.zoom_region"),
                    ],
                ),
                (
                    id: "display",
                    caption: "Display",
                    items: [
                        Command("view.show_annotations"),
                        Command("view.show_points"),
                        Command("view.rulers"),
                        Command("view.grid"),
                        Command("view.guides"),
                    ],
                ),
                (
                    id: "panels",
                    caption: "Panels",
                    items: [
                        Command("view.sidebar"),
                        Command("view.panel_tool"),
                        Command("view.panel_pages"),
                        Command("view.panel_bookmarks"),
                        Command("view.panel_layers"),
                        Command("view.panel_signatures"),
                        Command("view.panel_objects"),
                        Command("view.panel_forms"),
                    ],
                ),
                (
                    id: "window",
                    caption: "Window",
                    items: [
                        Command("view.previous_document"),
                        Command("view.next_document"),
                        Command("view.close_other_documents"),
                        Command("view.read_mode"),
                        Command("view.fullscreen"),
                        Command("view.reset_layout"),
                    ],
                ),
            ],
        ),
        (
            id: "pages",
            label: "Pages",
            question: "What am I doing to the set of pages?",
            groups: [
                (
                    id: "insert",
                    caption: "Insert",
                    items: [
                        Command("pages.insert_from_file"),
                    ],
                ),
                (
                    id: "organise",
                    caption: "Organise",
                    items: [
                        Command("pages.delete"),
                        Command("pages.extract"),
                        Command("pages.move_up"),
                        Command("pages.move_down"),
                        Command("pages.split"),
                        Command("pages.merge_into"),
                    ],
                ),
                (
                    id: "transform",
                    caption: "Transform",
                    items: [
                        Command("pages.rotate_left"),
                        Command("pages.rotate_right"),
                    ],
                ),
            ],
        ),
        (
            id: "edit",
            label: "Edit",
            question: "What am I changing about content that is already there?",
            groups: [
                (
                    id: "content",
                    caption: "Content",
                    items: [
                        Command("edit.text"),
                        Command("edit.add_text"),
                        Command("edit.objects"),
                    ],
                ),
                (
                    id: "insert",
                    caption: "Insert",
                    items: [
                        Command("edit.insert_image"),
                    ],
                ),
                (
                    id: "clipboard",
                    caption: "Clipboard",
                    items: [
                        Command("edit.cut"),
                        Command("edit.copy"),
                        Command("edit.paste"),
                    ],
                ),
                (
                    id: "forms",
                    caption: "Forms",
                    items: [
                        Command("edit.form_create_field"),
                        Command("edit.form_manage_fields"),
                        Command("edit.form_flatten"),
                    ],
                ),
                (
                    id: "protect",
                    caption: "Protect",
                    items: [
                        Command("edit.redact"),
                        Command("edit.redact_apply"),
                    ],
                ),
            ],
        ),
        (
            id: "markup",
            label: "Markup",
            question: "What am I adding for someone else to read?",
            groups: [
                (
                    id: "shapes",
                    caption: "Shapes",
                    items: [
                        Command("markup.rectangle"),
                        Command("markup.ellipse"),
                        Command("markup.arrow"),
                        Command("markup.polyline"),
                        Command("markup.polygon"),
                        Command("markup.cloud"),
                        Command("markup.ink"),
                        Command("markup.finish"),
                    ],
                ),
                (
                    id: "text_markup",
                    caption: "Text markup",
                    items: [
                        Command("markup.highlight"),
                        Command("markup.underline"),
                        Command("markup.strikeout"),
                        Command("markup.squiggly"),
                    ],
                ),
                (
                    id: "notes",
                    caption: "Notes",
                    items: [
                        Command("markup.text_box"),
                        Command("markup.sticky_note"),
                        Command("markup.stamp"),
                    ],
                ),
                (
                    id: "style",
                    caption: "Style",
                    items: [
                        Custom(
                            kind: "colour_swatch",
                        ),
                    ],
                ),
                (
                    id: "comments",
                    caption: "Comments",
                    items: [
                        Command("markup.comments"),
                    ],
                ),
            ],
        ),
        (
            id: "measure",
            label: "Measure",
            question: "What am I measuring, and in what units?",
            groups: [
                (
                    id: "dimension",
                    caption: "Dimension",
                    items: [
                        Command("measure.linear"),
                        Command("measure.radius_diameter"),
                        Command("measure.perimeter"),
                        Command("measure.length"),
                        Command("measure.two_line"),
                        Command("measure.finish"),
                    ],
                ),
                (
                    id: "scale",
                    caption: "Scale",
                    items: [
                        Command("measure.set_scale"),
                        Command("measure.manage_groups"),
                    ],
                ),
            ],
        ),
        (
            id: "tools",
            label: "Tools",
            question: "What do I run across files, or configure once?",
            groups: [
                (
                    id: "batch",
                    caption: "Batch",
                    items: [
                        Command("tools.merge_files"),
                        Command("tools.split_files"),
                    ],
                ),
                (
                    id: "fonts",
                    caption: "Fonts",
                    items: [
                        Command("tools.font_folders"),
                        Command("tools.embed_fonts"),
                        Command("tools.unembed_fonts"),
                    ],
                ),
                (
                    id: "diagnostics",
                    caption: "Diagnostics",
                    items: [
                        Command("tools.render_diagnostics"),
                    ],
                ),
            ],
        ),
    ],
    contextual_tabs: [
        (
            id: "format",
            label: "Format",
            question: "What am I changing about the thing I have selected?",
            visible_when: "selection.any",
            groups: [
                (
                    id: "selection",
                    caption: "Selection",
                    items: [
                        Command("format.properties"),
                        Command("format.delete"),
                    ],
                ),
            ],
        ),
    ],
    qat: [
        "file.open",
        "file.save",
        "edit.undo",
        "edit.redo",
    ],
    keymap: {
        "A": "view.tool_node",
        "Alt+Down": "pages.move_down",
        "Alt+Up": "pages.move_up",
        "Ctrl+0": "view.zoom_actual",
        "Ctrl+1": "mode.read",
        "Ctrl+2": "mode.review",
        "Ctrl+3": "mode.edit",
        "Ctrl+Alt+N": "file.new_from_template",
        "Ctrl+C": "edit.copy",
        "Ctrl+E": "edit.text",
        "Ctrl+F": "edit.find",
        "Ctrl+H": "view.read_mode",
        "Ctrl+N": "file.new",
        "Ctrl+O": "file.open",
        "Ctrl+P": "file.print",
        "Ctrl+S": "file.save",
        "Ctrl+Shift+C": "file.copy_page_text",
        "Ctrl+Shift+E": "edit.add_text",
        "Ctrl+Shift+S": "file.save_copy",
        "Ctrl+Shift+Tab": "view.previous_document",
        "Ctrl+Shift+Z": "edit.redo",
        "Ctrl+Tab": "view.next_document",
        "Ctrl+V": "edit.paste",
        "Ctrl+W": "file.close",
        "Ctrl+X": "edit.cut",
        "Ctrl+Y": "edit.redo",
        "Ctrl+Z": "edit.undo",
        "F11": "view.fullscreen",
        "H": "view.tool_hand",
        "T": "view.tool_text",
        "V": "view.tool_select",
        "[": "pages.rotate_left",
        "]": "pages.rotate_right",
    },
    menus: [
        (
            context: "canvas.object",
            items: [
                Command("view.zoom_selection"),
                Command("format.properties"),
                Command("format.delete"),
            ],
        ),
        (
            context: "canvas.empty",
            items: [
                Command("view.zoom_fit_page"),
                Command("view.zoom_fit_width"),
                Command("view.zoom_fit_height"),
                Command("view.zoom_actual"),
            ],
        ),
        (
            context: "dock.tab",
            items: [
                Command("view.reset_layout"),
            ],
        ),
        (
            context: "document.tab",
            items: [
                Command("file.close"),
                Command("view.close_other_documents"),
            ],
        ),
        (
            context: "objects.row",
            items: [
                Command("file.properties"),
            ],
        ),
        (
            context: "pages.row",
            items: [
                Command("pages.move_up"),
                Command("pages.move_down"),
                Command("pages.extract"),
                Command("pages.rotate_left"),
                Command("pages.rotate_right"),
                Command("pages.delete"),
            ],
        ),
    ],
)